{
  "name": "Notist Code",
  "scopeName": "source.notist.code",
  "patterns": [
    { "include": "#literals" },
    { "name": "keyword.control.notist", "match": "(?<![\\p{L}\\p{N}_-])(fn|import|as|let|for|in|if|else|match|comptime|where)(?![\\p{L}\\p{N}_-])" },
    { "name": "entity.name.function.notist", "match": "[\\p{L}_][\\p{L}\\p{N}_-]*(?=\\s*(?:<[^;{}\\n]*>)?\\s*\\()" },
    { "name": "support.type.notist", "match": "\\b[A-Z][\\p{L}\\p{N}_-]*" },
    { "include": "#content" },
    { "include": "#parentheses" },
    { "include": "#braces" },
    { "include": "#operators" }
  ],
  "repository": {
    "literals": { "patterns": [
      { "include": "#comments" },
      { "name": "string.quoted.double.path.notist", "begin": "\\bp\"", "end": "\"|(?=$)", "patterns": [{ "include": "#escapes" }] },
      { "name": "string.quoted.triple.raw.notist", "begin": "\\br(#+)\"\"\"", "end": "\"\"\"\\1" },
      { "name": "string.quoted.double.raw.notist", "begin": "\\br(#+)\"", "end": "\"\\1|(?=$)" },
      { "name": "string.quoted.triple.notist", "begin": "\"\"\"", "end": "\"\"\"", "patterns": [{ "include": "#escapes" }] },
      { "name": "string.quoted.double.notist", "begin": "\"", "end": "\"|(?=$)", "patterns": [{ "include": "#escapes" }] },
      { "name": "constant.numeric.notist", "match": "(?<![\\p{L}\\p{N}_-])[0-9]+(?:\\.[0-9]+)?(?![\\p{L}\\p{N}_-])" },
      { "name": "constant.language.notist", "match": "(?<![\\p{L}\\p{N}_-])(?:true|false|none)(?![\\p{L}\\p{N}_-])" }
    ] },
    "escapes": { "name": "constant.character.escape.notist", "match": "\\\\." },
    "comments": { "patterns": [
      { "name": "comment.line.double-slash.notist", "begin": "(?<!:)//", "end": "$" },
      { "include": "#block-comment" }
    ] },
    "block-comment": { "name": "comment.block.notist", "begin": "/\\*", "end": "\\*/", "patterns": [{ "include": "#block-comment" }] },
    "content": { "name": "meta.content.notist", "begin": "\\[", "beginCaptures": { "0": { "name": "punctuation.section.brackets.begin.notist" } }, "end": "\\]", "endCaptures": { "0": { "name": "punctuation.section.brackets.end.notist" } }, "patterns": [{ "include": "text.notist" }] },
    "parentheses": { "begin": "\\(", "end": "\\)", "patterns": [{ "include": "source.notist.code" }] },
    "braces": { "begin": "\\{", "end": "\\}", "patterns": [{ "include": "source.notist.code" }] },
    "operators": { "patterns": [
      { "name": "keyword.operator.notist", "match": "->|=>|==|!=|<=|>=|&&|\\|\\||[-+*/%=<>!?]" },
      { "name": "punctuation.separator.notist", "match": "[.,:;]" }
    ] }
  }
}
