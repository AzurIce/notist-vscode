{
  "name": "Notist",
  "scopeName": "source.notist",
  "patterns": [
    { "include": "#literals" },
    { "name": "keyword.control.notist", "match": "(?<![\\p{L}\\p{N}_-])(fn|import|as|let|for|in|if|else|match|where)(?![\\p{L}\\p{N}_-])" },
    { "name": "variable.language.self.notist", "match": "(?<![\\p{L}\\p{N}_-])self(?![\\p{L}\\p{N}_-])" },
    { "name": "entity.name.function.notist", "match": "[\\p{L}_][\\p{L}\\p{N}_-]*(?=\\s*(?:<[^;{}\\n]*>)?\\s*[(\\[])" },
    { "name": "support.type.notist", "match": "\\b[A-Z][\\p{L}\\p{N}_-]*" },
    { "include": "#content" },
    { "include": "#parentheses" },
    { "include": "#braces" },
    { "include": "#operators" }
  ],
  "repository": {
    "literals": { "patterns": [
      { "include": "#comments" },
      { "name": "string.quoted.triple.raw.notist", "begin": "\\br(#+)\"\"\"", "end": "\"\"\"\\1" },
      { "name": "string.quoted.double.raw.notist", "begin": "\\br(#+)\"", "end": "\"\\1|(?=$)" },
      { "name": "string.quoted.triple.notist", "begin": "\"\"\"", "end": "\"\"\"", "patterns": [{ "include": "#escapes" }] },
      { "name": "string.quoted.double.notist", "begin": "\"", "end": "\"|(?=$)", "patterns": [{ "include": "#escapes" }] },
      { "name": "constant.numeric.notist", "match": "(?<![\\p{L}\\p{N}_-])[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?![\\p{L}\\p{N}_-])" },
      { "name": "constant.language.notist", "match": "(?<![\\p{L}\\p{N}_-])(?:true|false)(?![\\p{L}\\p{N}_-])" }
    ] },
    "escapes": { "name": "constant.character.escape.notist", "match": "\\\\." },
    "comments": { "patterns": [
      { "name": "comment.line.double-slash.notist", "begin": "(?<!:)//", "end": "$" },
      { "include": "#block-comment" }
    ] },
    "block-comment": { "name": "comment.block.notist", "begin": "/\\*", "end": "\\*/", "patterns": [{ "include": "#block-comment" }] },
    "content": {
      "name": "meta.content.notist",
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.section.brackets.begin.notist" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.section.brackets.end.notist" } },
      "patterns": [
        { "include": "notist.markdown.injection#content-inner" },
        { "include": "text.html.markdown.notist" }
      ]
    },
    "parentheses": { "begin": "\\(", "end": "\\)", "patterns": [{ "include": "source.notist" }] },
    "braces": { "begin": "\\{", "end": "\\}", "patterns": [{ "include": "source.notist" }] },
    "operators": { "patterns": [
      { "name": "keyword.operator.notist", "match": "->|=>|==|!=|<=|>=|&&|\\|\\||[-+*/%=<>!]" },
      { "name": "punctuation.separator.notist", "match": "[.,:;]" }
    ] }
  }
}
